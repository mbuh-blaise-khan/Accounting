# Universal Accounting Platform — environment variables
# Copy this file to `.env` (or backend/.env for backend-local) and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# Database
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>

# Auth / JWT
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment: development | testing | production
ENV=development

# Frontend dev server origin (used by CORS)
FRONTEND_ORIGIN=http://localhost:5173
