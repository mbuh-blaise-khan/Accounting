# Universal Accounting Platform — backend environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# PostgreSQL connection string (psycopg2 driver)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Example using the dev user/db from README "Getting Started":
DATABASE_URL=postgresql+psycopg2://uap:uap_dev_password@localhost:5432/uap_dev

# Auth / JWT (Session 3+)
# Use a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true only when served over HTTPS (production). Kept false for local dev.
COOKIE_SECURE=false
# bcrypt cost factor. Keep low locally for speed; raise to >=12 before production.
BCRYPT_ROUNDS=4

# Environment: development | testing | production
ENV=development

# Frontend dev server origin (used by CORS in Session 2)
FRONTEND_ORIGIN=http://localhost:5173
