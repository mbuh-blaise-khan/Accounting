# Universal Accounting Platform — backend environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# PostgreSQL connection string (psycopg2 driver)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Example using the dev user/db from README "Getting Started":
DATABASE_URL=postgresql+psycopg2://uap:uap_dev_password@localhost:5432/uap_dev

# Auth / JWT (used in Session 3+)
SECRET_KEY=change-me-to-a-long-random-string

# Environment: development | testing | production
ENV=development

# Frontend dev server origin (used by CORS in Session 2)
FRONTEND_ORIGIN=http://localhost:5173
